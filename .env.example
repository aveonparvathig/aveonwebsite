# Sanity CMS — create a project at sanity.io and fill these in.
# The site runs on local fallback content until these are set.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
SANITY_API_TOKEN=

# Email delivery for contact / demo forms + lead auto-reply
RESEND_API_KEY=
# Optional: where form notifications are sent (defaults to contact@aveoninfotech.com)
CONTACT_NOTIFY_EMAIL=
# Optional verified sender once your domain is set up in Resend, e.g. "Aveon <hello@aveoninfotech.com>".
# Until then leads/auto-replies send from Resend's shared sender (reaches the Resend account owner only).
RESEND_FROM=

# Lead persistence: leads are written to Sanity (Studio becomes the lead inbox) when an
# Editor-scoped token is set. Reuses SANITY_API_TOKEN (above) unless you set a dedicated one here.
SANITY_API_WRITE_TOKEN=

# Paid-channel tags (optional — the site runs unchanged until these are set).
# Google Ads conversion tracking:
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook/Instagram) Pixel for retargeting + Lead events:
NEXT_PUBLIC_META_PIXEL_ID=

# Shared secret for the Sanity → site revalidation webhook (any long random string)
SANITY_REVALIDATE_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://www.aveoninfotech.com

# AI chat widget (optional). Without a key, the widget runs a fully-working
# guided/scripted flow. Set a key to enable free-form AI answers.
# The provider seam lives in lib/chat/assistant.ts (generateAiReply) — swap it
# for any provider. The bundled reference implementation calls Anthropic.
ANTHROPIC_API_KEY=
# Optional model override for the chat widget (default: claude-haiku-4-5)
CHAT_MODEL=
